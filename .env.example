# ==============================================================================
# STUDENTLIFE ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini menjadi .env lalu isi nilainya:
# copy .env.example .env
#
# PERINGATAN: File .env sudah dimasukkan ke .gitignore,
# JANGAN PERNAH commit kredensial asli ke repositori Git!
# ==============================================================================

# Figma API Access (Personal Access Token dari figma.com/settings)
FIGMA_API_KEY=your_figma_personal_access_token_here

# Supabase Credentials (dari Dashboard Supabase -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
